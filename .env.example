# ============================================================
# agri-kb 配置示例：复制为 .env 后按需修改
# ============================================================

# ---------- 大模型 ----------
# 可选：deepseek / shennong / qwen / zhipu / moonshot / ollama / custom
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 连接超时压短、重试次数给足：线路偶发握手丢包时，快速失败再试
# 比死等一次更划算（正常握手只要 0.1 秒左右）
LLM_CONNECT_TIMEOUT=5
LLM_MAX_RETRIES=2
# 长连接复用时长（秒），避免每次提问都重新握手
LLM_KEEPALIVE_EXPIRY=300
LLM_TIMEOUT=60

# 神农大模型（中国农业大学）：拿到接入信息后取消注释并填写。
# 只要对方提供的是 OpenAI 兼容接口，这里填完即可切换，无需改代码。
# SHENNONG_BASE_URL=
# SHENNONG_MODEL=
# SHENNONG_API_KEY=

# 任意 OpenAI 兼容服务都可用下面三个变量接入
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# ---------- 向量检索 ----------
# 国内网络访问 HuggingFace 不通时用镜像
HF_ENDPOINT=https://hf-mirror.com
EMBED_ENABLED=true
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_WARMUP=true

# ---------- 重排（可选，能明显提升精度）----------
# 重排模型约 1GB，先执行下面这条命令下好再打开开关：
#   python -m app.tools.prefetch_models --rerank-only
# 轻量替代：cross-encoder/mmarco-mMiniLMv2-L12-H384-v1（约 470MB）
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_CANDIDATES=20

# ---------- 检索参数 ----------
RAG_TOP_K=5
RAG_CHUNK_SIZE=400
# 小于该长度的碎片并入相邻片段（避免 20 来字的碎片占掉一个参考槽位）
RAG_MIN_CHUNK_SIZE=80
RAG_BM25_WEIGHT=0.3
RAG_EMBED_WEIGHT=0.7
RAG_MAX_CHUNKS_PER_DOC=2

# ---------- 会话存储 ----------
# json：单文件、可读、适合个人使用
# sqlite：只写增量行、支持并发与事务，适合多人使用
SESSION_BACKEND=json
SESSION_MAX=100
SESSION_HISTORY_WINDOW=10

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
